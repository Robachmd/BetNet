# ──────────────────────────────────────────────
# BetNet Frontend – Environment Variables
# Copy this file to .env and fill in real values
# ──────────────────────────────────────────────

# Backend API (axios base path; baked in at "npm run build" time)
#
# Development: CRA on :3000, Django on :8000 — use the full API origin:
#   REACT_APP_API_URL=http://localhost:8000/api
#
# Production (same host as the site, e.g. Django+Whitenoise or nginx on one domain):
#   REACT_APP_API_URL=/api
# so the browser calls https://yourdomain/api/... with no localhost.
#
# Docker Compose with nginx (this repo): browser hits nginx :80; set before build:
#   REACT_APP_API_URL=/api
#   REACT_APP_WS_URL=ws://localhost
#   REACT_APP_UPLOADS_URL=http://localhost
REACT_APP_API_URL=http://localhost:8000/api
REACT_APP_WS_URL=ws://localhost:8000
REACT_APP_UPLOADS_URL=http://localhost:8000

# Maps (Leaflet uses OpenStreetMap by default — key optional)
REACT_APP_GOOGLE_MAPS_KEY=

# Chapa payment (public/client key)
REACT_APP_CHAPA_PUBLIC_KEY=CHAPUBK_TEST-Xu1cl1yGUpEnkTAq8tjO1YtNe8m47EVu
