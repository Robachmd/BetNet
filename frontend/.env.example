# ──────────────────────────────────────────────
# BetRent Frontend – Environment Variables
# Copy this file to .env and fill in real values
# ──────────────────────────────────────────────

# Backend API
REACT_APP_API_URL=http://localhost:8000/api
REACT_APP_WS_URL=ws://localhost:8001/ws

# Maps (Leaflet uses OpenStreetMap by default — key optional)
REACT_APP_GOOGLE_MAPS_KEY=

# Chapa payment (public/client key)
REACT_APP_CHAPA_PUBLIC_KEY=
