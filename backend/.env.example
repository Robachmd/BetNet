# ──────────────────────────────────────────────
# BetNet – Environment Variables
# Copy this file to .env and fill in real values
# ──────────────────────────────────────────────

# Django core
SECRET_KEY=your-very-secret-key-change-me
DEBUG=True
# True: legacy Bootstrap templates on port 8000 (home, login, dashboard, …).
# False: API-only for users; run "cd frontend && npm run build" so ../frontend/build exists,
# then Django serves the React app at / (Whitenoise + catch-all) or use nginx only in Docker.
SERVE_DJANGO_PAGES=True
ALLOWED_HOSTS=localhost,127.0.0.1
LANGUAGE_CODE=en

# Listing fee (ETB) before a new property is visible on search / home
LISTING_FEE_ETB=150.00

# Database (PostgreSQL)
DATABASE_URL=postgres://betnet:betnet@localhost:5432/betnet

# Redis (Channels + Celery)
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173

# Cloudinary (remote media storage)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Uncomment below to use Cloudinary for file storage:
# DEFAULT_FILE_STORAGE=cloudinary_storage.storage.MediaCloudinaryStorage

# Stripe payments
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Chapa payments
CHAPA_SECRET_KEY=CHAPUBK_TEST-Xu1cl1yGUpEnkTAq8tjO1YtNe8m47EVu

# Email (switch to SMTP in production)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=BetNet <noreply@betnet.com>

# Security (production only)
SECURE_SSL_REDIRECT=False

# Logging
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=WARNING
